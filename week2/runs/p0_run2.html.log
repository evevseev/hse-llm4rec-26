<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Random Lunch Generator</title>
  <style>
    :root {
      --cream: #fff8ed;
      --paper: #fffdf8;
      --ink: #2d2926;
      --muted: #776f68;
      --coral: #e9674f;
      --orange: #f4a340;
      --sage: #9ab79c;
      --line: #eadfd0;
      --shadow: 0 24px 70px rgba(74, 49, 31, 0.12);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      background:
        radial-gradient(circle at 8% 10%, rgba(244, 163, 64, 0.18), transparent 28%),
        radial-gradient(circle at 92% 88%, rgba(154, 183, 156, 0.22), transparent 30%),
        var(--cream);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .wrapper {
      width: min(1120px, calc(100% - 36px));
      margin: 0 auto;
      padding: 28px 0 36px;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 54px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      font-weight: 800;
      letter-spacing: -0.04em;
      font-size: 1.12rem;
    }

    .brand-mark {
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      border-radius: 12px;
      background: var(--coral);
      color: white;
      font-size: 1.35rem;
      box-shadow: 0 8px 18px rgba(233, 103, 79, 0.25);
    }

    .tagline {
      color: var(--muted);
      font-size: 0.9rem;
      font-weight: 600;
    }

    main {
      display: grid;
      grid-template-columns: 0.84fr 1.16fr;
      align-items: center;
      gap: clamp(38px, 7vw, 94px);
    }

    .intro {
      animation: rise 0.7s ease both;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 18px;
      color: var(--coral);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 28px;
      height: 2px;
      background: var(--coral);
    }

    h1 {
      max-width: 510px;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(3.4rem, 7vw, 6.5rem);
      font-weight: 500;
      line-height: 0.92;
      letter-spacing: -0.075em;
    }

    h1 em {
      color: var(--coral);
      font-style: italic;
    }

    .intro p {
      max-width: 425px;
      margin: 28px 0 0;
      color: var(--muted);
      font-size: 1.06rem;
      line-height: 1.7;
    }

    .tip {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 32px;
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 600;
    }

    .tip span {
      display: grid;
      place-items: center;
      width: 27px;
      height: 27px;
      border: 1px solid var(--line);
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.55);
    }

    .menu-card {
      position: relative;
      padding: clamp(24px, 4vw, 50px);
      border: 1px solid rgba(234, 223, 208, 0.9);
      border-radius: 28px;
      background: rgba(255, 253, 248, 0.86);
      box-shadow: var(--shadow);
      text-align: center;
      animation: rise 0.7s 0.12s ease both;
    }

    .menu-card::before,
    .menu-card::after {
      position: absolute;
      z-index: -1;
      content: "";
      border-radius: 28px;
      inset: 14px -12px -13px 12px;
      background: rgba(154, 183, 156, 0.27);
      transform: rotate(2.5deg);
    }

    .menu-card::after {
      z-index: -2;
      inset: -11px 13px 14px -13px;
      background: rgba(244, 163, 64, 0.18);
      transform: rotate(-2deg);
    }

    .card-label {
      color: var(--muted);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .dish-illustration {
      display: grid;
      place-items: center;
      width: 148px;
      height: 148px;
      margin: 24px auto 17px;
      border-radius: 50%;
      background: #fff1d9;
      font-size: 5.8rem;
      line-height: 1;
      transition: transform 0.3s ease;
    }

    .menu-card:hover .dish-illustration {
      transform: rotate(5deg) scale(1.04);
    }

    .dish-name {
      min-height: 52px;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.8rem, 4vw, 2.55rem);
      font-weight: 500;
      letter-spacing: -0.045em;
    }

    .dish-description {
      min-height: 48px;
      margin: 10px auto 0;
      max-width: 390px;
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.55;
    }

    .generate-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      min-height: 56px;
      margin-top: 27px;
      padding: 14px 22px;
      border: 0;
      border-radius: 14px;
      color: white;
      background: var(--coral);
      box-shadow: 0 10px 18px rgba(233, 103, 79, 0.2);
      cursor: pointer;
      font: inherit;
      font-size: 0.96rem;
      font-weight: 800;
      transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .generate-button:hover {
      background: #d95640;
      box-shadow: 0 13px 24px rgba(233, 103, 79, 0.28);
      transform: translateY(-2px);
    }

    .generate-button:active {
      transform: translateY(1px);
    }

    .generate-button:focus-visible {
      outline: 4px solid rgba(233, 103, 79, 0.25);
      outline-offset: 3px;
    }

    .shuffle-icon {
      font-size: 1.25rem;
      transition: transform 0.4s ease;
    }

    .generate-button:hover .shuffle-icon {
      transform: rotate(180deg);
    }

    .history {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      min-height: 28px;
      margin-top: 17px;
    }

    .history-item {
      padding: 6px 10px;
      border: 1px solid var(--line);
      border-radius: 20px;
      color: var(--muted);
      background: white;
      font-size: 0.72rem;
      font-weight: 700;
    }

    .rolling .dish-illustration {
      animation: wobble 0.45s ease;
    }

    .rolling .dish-name,
    .rolling .dish-description {
      animation: fade 0.45s ease;
    }

    footer {
      margin-top: 78px;
      color: var(--muted);
      font-size: 0.78rem;
      text-align: center;
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes wobble {
      0%, 100% { transform: rotate(0) scale(1); }
      35% { transform: rotate(-8deg) scale(1.07); }
      70% { transform: rotate(8deg) scale(1.04); }
    }

    @keyframes fade {
      0% { opacity: 0.2; transform: translateY(5px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 760px) {
      .wrapper {
        width: min(100% - 28px, 540px);
        padding-top: 20px;
      }

      header {
        margin-bottom: 48px;
      }

      .tagline {
        display: none;
      }

      main {
        grid-template-columns: 1fr;
        gap: 42px;
      }

      h1 {
        font-size: clamp(3.5rem, 17vw, 5.4rem);
      }

      .intro p {
        margin-top: 22px;
      }

      .tip {
        margin-top: 23px;
      }

      .menu-card {
        padding: 27px 22px 24px;
      }

      footer {
        margin-top: 58px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <header>
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">🍴</div>
        <span>Lunch, sorted.</span>
      </div>
      <div class="tagline">A little inspiration for your midday break</div>
    </header>

    <main>
      <section class="intro">
        <div class="eyebrow">Daily decision helper</div>
        <h1>What will you eat for <em>lunch?</em></h1>
        <p>
          Skip the endless debate. Let a tiny bit of randomness serve up
          something delicious for your next midday meal.
        </p>
        <div class="tip">
          <span aria-hidden="true">✦</span>
          <div>One click. Zero overthinking.</div>
        </div>
      </section>

      <section class="menu-card" aria-live="polite">
        <div class="card-label">Your lunch suggestion</div>
        <div class="dish-illustration" id="dishEmoji" aria-hidden="true">🥗</div>
        <h2 class="dish-name" id="dishName">Rainbow Grain Bowl</h2>
        <p class="dish-description" id="dishDescription">
          A colorful bowl of grains, roasted vegetables, greens, and a bright dressing.
        </p>
        <button class="generate-button" id="generateButton" type="button">
          <span class="shuffle-icon" aria-hidden="true">⤨</span>
          <span>Generate another lunch</span>
        </button>
        <div class="history" id="history" aria-label="Previous suggestions"></div>
      </section>
    </main>

    <footer>
      Made for hungry minds · No wrong answers, only tasty possibilities
    </footer>
  </div>

  <script>
    const lunches = [
      {
        name: "Rainbow Grain Bowl",
        emoji: "🥗",
        description: "A colorful bowl of grains, roasted vegetables, greens, and a bright dressing."
      },
      {
        name: "Spicy Miso Ramen",
        emoji: "🍜",
        description: "Silky noodles in a rich miso broth with mushrooms, greens, and a soft egg."
      },
      {
        name: "Crispy Chicken Wrap",
        emoji: "🌯",
        description: "Crunchy chicken, fresh lettuce, tomato, and a creamy sauce in a warm wrap."
      },
      {
        name: "Margherita Pizza",
        emoji: "🍕",
        description: "A classic slice with bubbling mozzarella, sweet tomato, and fragrant basil."
      },
      {
        name: "Green Pesto Pasta",
        emoji: "🍝",
        description: "Al dente pasta tossed with vibrant pesto, parmesan, and roasted cherry tomatoes."
      },
      {
        name: "Sushi Set",
        emoji: "🍣",
        description: "A satisfying selection of fresh rolls, nigiri, edamame, and a little soy sauce."
      },
      {
        name: "Street-Style Tacos",
        emoji: "🌮",
        description: "Soft tortillas filled with seasoned vegetables, salsa, lime, and plenty of flavor."
      },
      {
        name: "Loaded Baked Potato",
        emoji: "🥔",
        description: "A fluffy potato piled high with cheese, beans, herbs, and your favorite toppings."
      },
      {
        name: "Falafel Pita",
        emoji: "🧆",
        description: "Golden falafel tucked into warm pita with crunchy salad and tahini sauce."
      },
      {
        name: "Tomato Soup & Toast",
        emoji: "🍲",
        description: "A comforting bowl of creamy tomato soup paired with crisp, buttery toast."
      }
    ];

    const dishEmoji = document.getElementById("dishEmoji");
    const dishName = document.getElementById("dishName");
    const dishDescription = document.getElementById("dishDescription");
    const generateButton = document.getElementById("generateButton");
    const history = document.getElementById("history");
    const card = document.querySelector(".menu-card");

    let recentLunches = ["Rainbow Grain Bowl"];

    function pickLunch() {
      const available = lunches.filter((lunch) => !recentLunches.includes(lunch.name));
      const choices = available.length ? available : lunches;
      return choices[Math.floor(Math.random() * choices.length)];
    }

    function updateHistory(name) {
      recentLunches = [name, ...recentLunches.filter((item) => item !== name)].slice(0, 3);
      history.innerHTML = recentLunches
        .slice(1)
        .map((item) => `<span class="history-item">${item}</span>`)
        .join("");
    }

    function generateLunch() {
      const lunch = pickLunch();

      card.classList.remove("rolling");
      void card.offsetWidth;
      card.classList.add("rolling");

      dishEmoji.textContent = lunch.emoji;
      dishName.textContent = lunch.name;
      dishDescription.textContent = lunch.description;
      updateHistory(lunch.name);
    }

    generateButton.addEventListener("click", generateLunch);
  </script>
</body>
</html>
```
