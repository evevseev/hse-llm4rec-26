  <title>Random Lunch Generator</title>
  <style>
    :root {
      --ink: #172018;
      --muted: #667267;
      --cream: #fffaf0;
      --paper: #fffef9;
      --orange: #f26b38;
      --yellow: #ffd166;
      --green: #3f8065;
      --line: #e7dfcf;
      --shadow: 0 24px 60px rgba(56, 47, 30, 0.14);
