<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="A fun random lunch menu generator." />
  <title>Random Lunch Generator</title>
  <style>
    :root {
      --cream: #fff8ed;
      --paper: #fffdf8;
      --ink: #24211d;
      --muted: #756d63;
      --orange: #f26b38;
      --orange-dark: #d95222;
      --yellow: #ffd166;
      --mint: #b8e0d2;
      --shadow: 0 24px 70px rgba(71, 43, 22, 0.14);
      --radius: 28px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      background:
        radial-gradient(circle at 10% 10%, rgba(255, 209, 102, 0.45), transparent 23rem),
        radial-gradient(circle at 90% 90%, rgba(184, 224, 210, 0.6), transparent 25rem),
        var(--cream);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
        "Segoe UI", sans-serif;
      display: grid;
      place-items: center;
      padding: 24px;
    }

    .app {
      width: min(100%, 980px);
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      background: var(--paper);
      border: 1px solid rgba(36, 33, 29, 0.08);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .intro {
      position: relative;
      isolation: isolate;
      padding: clamp(32px, 6vw, 70px);
      background: var(--orange);
      color: white;
      overflow: hidden;
    }

    .intro::before,
    .intro::after {
      content: "";
      position: absolute;
      z-index: -1;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.12);
    }

    .intro::before {
      width: 300px;
      height: 300px;
      right: -150px;
      top: -110px;
    }

    .intro::after {
      width: 220px;
      height: 220px;
      left: -120px;
      bottom: -80px;
    }

    .eyebrow {
      margin: 0 0 20px;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      opacity: 0.78;
    }

    h1 {
      max-width: 380px;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(3rem, 7vw, 5.5rem);
      line-height: 0.9;
      letter-spacing: -0.07em;
    }

    .intro p:not(.eyebrow) {
      max-width: 330px;
      margin: 28px 0 0;
      color: rgba(255, 255, 255, 0.83);
      font-size: 1.05rem;
      line-height: 1.6;
    }

    .plate {
      width: 170px;
      height: 170px;
      margin: 52px auto 0;
      border: 12px solid rgba(255, 255, 255, 0.85);
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: rgba(255, 255, 255, 0.12);
      box-shadow:
        inset 0 0 0 8px rgba(255, 255, 255, 0.16),
        0 12px 30px rgba(105, 37, 11, 0.18);
      font-size: 4.5rem;
      transform: rotate(-8deg);
    }

    .generator {
      padding: clamp(32px, 6vw, 70px);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .generator h2 {
      margin: 0;
      font-size: 1.1rem;
      color: var(--muted);
      font-weight: 700;
    }

    .result {
      min-height: 270px;
      margin: 20px 0 28px;
      padding: 34px 26px;
      border: 2px dashed rgba(36, 33, 29, 0.16);
      border-radius: 22px;
      display: grid;
      place-items: center;
      text-align: center;
      background: #fffaf0;
    }

    .result-content {
      width: 100%;
    }

    .food-emoji {
      display: block;
      margin-bottom: 14px;
      font-size: 4.8rem;
      line-height: 1;
    }

    .food-name {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2rem, 5vw, 3.5rem);
      line-height: 1;
      letter-spacing: -0.05em;
    }

    .food-description {
      margin: 14px auto 0;
      max-width: 390px;
      color: var(--muted);
      line-height: 1.5;
    }

    .placeholder {
      color: var(--muted);
      font-size: 1.1rem;
      line-height: 1.5;
    }

    button {
      border: 0;
      border-radius: 999px;
      padding: 18px 26px;
      color: white;
      background: var(--orange);
      box-shadow: 0 10px 18px rgba(242, 107, 56, 0.25);
      cursor: pointer;
      font: inherit;
      font-weight: 800;
      font-size: 1rem;
      transition: transform 160ms ease, background 160ms ease, box-shadow 160ms ease;
    }

    button:hover {
      background: var(--orange-dark);
      box-shadow: 0 14px 24px rgba(242, 107, 56, 0.3);
      transform: translateY(-2px);
    }

    button:active {
      transform: translateY(1px);
    }

    button:focus-visible {
      outline: 4px solid rgba(255, 209, 102, 0.9);
      outline-offset: 4px;
    }

    .hint {
      margin: 18px 0 0;
      text-align: center;
      color: var(--muted);
      font-size: 0.85rem;
    }

    .pop {
      animation: pop 420ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    @keyframes pop {
      0% {
        opacity: 0;
        transform: scale(0.88) rotate(-2deg);
      }
      70% {
        transform: scale(1.04) rotate(1deg);
      }
      100% {
        opacity: 1;
        transform: scale(1) rotate(0);
      }
    }

    @media (max-width: 720px) {
      body {
        padding: 14px;
      }

      .app {
        grid-template-columns: 1fr;
      }

      .intro {
        padding: 38px 28px 30px;
        text-align: center;
      }

      .intro p:not(.eyebrow) {
        margin-left: auto;
        margin-right: auto;
      }

      .plate {
        width: 120px;
        height: 120px;
        margin-top: 34px;
        border-width: 8px;
        font-size: 3.2rem;
      }

      .generator {
        padding: 34px 24px 38px;
      }

      .result {
        min-height: 230px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>
  <main class="app">
    <section class="intro" aria-labelledby="page-title">
      <p class="eyebrow">Your daily decision helper</p>
      <h1 id="page-title">What’s for lunch?</h1>
      <p>
        Skip the indecision. Let a little randomness choose something delicious
        for you today.
      </p>
      <div class="plate" aria-hidden="true">🍱</div>
    </section>

    <section class="generator" aria-labelledby="generator-title">
      <h2 id="generator-title">Today’s recommendation</h2>

      <div class="result" aria-live="polite" aria-atomic="true">
        <div class="result-content">
          <span class="placeholder">Click the button and discover your next lunch.</span>
        </div>
      </div>

      <button id="generate-button" type="button">Generate my lunch <span aria-hidden="true">→</span></button>
      <p class="hint">Press the button again if you’re not convinced.</p>
    </section>
  </main>

  <script>
    const menus = [
      {
        name: "Spicy Ramen",
        emoji: "🍜",
        description: "A warm bowl of noodles, vegetables, and just enough chili to wake you up."
      },
      {
        name: "Crispy Tacos",
        emoji: "🌮",
        description: "Crunchy shells packed with seasoned filling, fresh salsa, and lime."
      },
      {
        name: "Sushi Bento",
        emoji: "🍣",
        description: "A colorful little box of sushi, rice, and tasty sides for a balanced break."
      },
      {
        name: "Margherita Pizza",
        emoji: "🍕",
        description: "Simple, comforting, and topped with tomato, mozzarella, and fresh basil."
      },
      {
        name: "Falafel Pita",
        emoji: "🥙",
        description: "Golden falafel, creamy hummus, crisp salad, and a warm pita."
      },
      {
        name: "Veggie Burger",
        emoji: "🍔",
        description: "A satisfying plant-based patty with crunchy toppings and a toasted bun."
      },
      {
        name: "Fresh Poke Bowl",
        emoji: "🥗",
        description: "Rice, colorful vegetables, and your favorite toppings in one bright bowl."
      },
      {
        name: "Creamy Pasta",
        emoji: "🍝",
        description: "A generous plate of pasta in a silky sauce with herbs and parmesan."
      },
      {
        name: "Chicken Curry",
        emoji: "🍛",
        description: "Fragrant spices, tender chicken, and fluffy rice for a comforting lunch."
      },
      {
        name: "Grilled Cheese",
        emoji: "🥪",
        description: "Golden toasted bread, bubbling cheese, and a side of tomato soup."
      }
    ];

    const button = document.getElementById("generate-button");
    const result = document.querySelector(".result-content");

    let lastIndex = -1;

    function generateLunch() {
      let index;

      do {
        index = Math.floor(Math.random() * menus.length);
      } while (menus.length > 1 && index === lastIndex);

      lastIndex = index;
      const lunch = menus[index];

      result.classList.remove("pop");
      void result.offsetWidth;
      result.classList.add("pop");

      result.innerHTML = `
        <span class="food-emoji" aria-hidden="true">${lunch.emoji}</span>
        <h3 class="food-name">${lunch.name}</h3>
        <p class="food-description">${lunch.description}</p>
      `;
    }

    button.addEventListener("click", generateLunch);
  </script>
</body>
</html>
```
