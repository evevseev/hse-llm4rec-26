```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Random Lunch Menu</title>
  <style>
    :root {
      --cream: #fff8ed;
      --ink: #28231f;
      --muted: #796f66;
      --orange: #ef7d32;
      --orange-dark: #c85d1c;
      --yellow: #ffd166;
      --card: #ffffff;
      --shadow: 0 24px 70px rgba(103, 66, 26, 0.14);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      background:
        radial-gradient(circle at 12% 12%, rgba(255, 209, 102, 0.38), transparent 24rem),
        radial-gradient(circle at 92% 88%, rgba(239, 125, 50, 0.18), transparent 26rem),
        var(--cream);
      font-family: Georgia, "Times New Roman", serif;
    }

    .page {
      width: min(100% - 32px, 960px);
      margin: 0 auto;
      padding: 48px 0 32px;
    }

    header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 34px;
    }

    .eyebrow {
      margin: 0 0 10px;
      color: var(--orange-dark);
      font: 700 0.76rem/1.2 Arial, sans-serif;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    h1 {
      max-width: 600px;
      margin: 0;
      font-size: clamp(2.8rem, 8vw, 6.8rem);
      line-height: 0.88;
      letter-spacing: -0.07em;
      font-weight: 900;
    }

    .header-note {
      width: 180px;
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.45;
    }

    .menu-card {
      position: relative;
      overflow: hidden;
      min-height: 520px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: clamp(28px, 6vw, 62px);
      border: 1px solid rgba(120, 85, 44, 0.12);
      border-radius: 34px;
      background: var(--card);
      box-shadow: var(--shadow);
    }

    .menu-card::before {
      content: "";
      position: absolute;
      width: 240px;
      height: 240px;
      top: -100px;
      right: -80px;
      border: 26px solid rgba(255, 209, 102, 0.34);
      border-radius: 50%;
    }

    .menu-card::after {
      content: "✦";
      position: absolute;
      right: 52px;
      bottom: 28px;
      color: rgba(239, 125, 50, 0.22);
      font: 3rem Arial, sans-serif;
    }

    .label {
      position: relative;
      z-index: 1;
      color: var(--muted);
      font: 700 0.78rem/1 Arial, sans-serif;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .dish {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 28px;
      margin: 42px 0;
    }

    .dish-name {
      margin: 0;
      font-size: clamp(2.8rem, 8vw, 6.7rem);
      line-height: 0.9;
      letter-spacing: -0.065em;
      overflow-wrap: anywhere;
    }

    .dish-emoji {
      font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
      font-size: clamp(5.5rem, 18vw, 12rem);
      line-height: 1;
      filter: drop-shadow(0 12px 10px rgba(80, 45, 15, 0.13));
      user-select: none;
    }

    .dish-description {
      max-width: 420px;
      margin: 22px 0 0;
      color: var(--muted);
      font-size: 1.08rem;
      line-height: 1.5;
    }

    .controls {
      position: relative;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
    }

    button {
      border: 0;
      border-radius: 999px;
      padding: 17px 25px;
      color: #fff;
      background: var(--orange);
      box-shadow: 0 9px 18px rgba(200, 93, 28, 0.22);
      cursor: pointer;
      font: 700 0.94rem Arial, sans-serif;
      transition: transform 160ms ease, background 160ms ease, box-shadow 160ms ease;
    }

    button:hover {
      background: var(--orange-dark);
      box-shadow: 0 12px 24px rgba(200, 93, 28, 0.28);
      transform: translateY(-2px);
    }

    button:active {
      transform: translateY(1px);
    }

    button:focus-visible {
      outline: 4px solid rgba(255, 209, 102, 0.8);
      outline-offset: 4px;
    }

    .hint {
      color: var(--muted);
      font: 0.87rem Arial, sans-serif;
    }

    .animate {
      animation: reveal 420ms ease both;
    }

    @keyframes reveal {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    footer {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding: 22px 4px 0;
      color: var(--muted);
      font: 0.78rem Arial, sans-serif;
    }

    @media (max-width: 650px) {
      .page {
        padding-top: 28px;
      }

      header {
        display: block;
      }

      .header-note {
        width: auto;
        margin-top: 18px;
      }

      .menu-card {
        min-height: 560px;
        border-radius: 26px;
      }

      .dish {
        grid-template-columns: 1fr;
        gap: 18px;
        margin: 56px 0 42px;
      }

      .dish-emoji {
        order: -1;
        font-size: 6.5rem;
      }

      .dish-description {
        font-size: 1rem;
      }

      footer {
        display: block;
      }

      footer span {
        display: block;
        margin-bottom: 8px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>
  <main class="page">
    <header>
      <div>
        <p class="eyebrow">A small answer to a big question</p>
        <h1>What’s for lunch?</h1>
      </div>
      <p class="header-note">
        No overthinking. No endless scrolling. Just press the button.
      </p>
    </header>

    <section class="menu-card" aria-live="polite">
      <span class="label">Today’s random menu</span>

      <div class="dish" id="dishContent">
        <div>
          <h2 class="dish-name" id="dishName">Tacos</h2>
          <p class="dish-description" id="dishDescription">
            A bright, crunchy lunch with plenty of room for your favorite toppings.
          </p>
        </div>
        <div class="dish-emoji" id="dishEmoji" role="img" aria-label="Tacos">🌮</div>
      </div>

      <div class="controls">
        <button id="generateButton" type="button">Generate lunch</button>
        <span class="hint">Your next meal is one click away.</span>
      </div>
    </section>

    <footer>
      <span>Randomly selected from a menu of favorites.</span>
      <span>Made for decisive lunch breaks.</span>
    </footer>
  </main>

  <script>
    const dishes = [
      {
        name: "Tacos",
        emoji: "🌮",
        description: "A bright, crunchy lunch with plenty of room for your favorite toppings."
      },
      {
        name: "Pizza",
        emoji: "🍕",
        description: "A warm, cheesy classic that never needs a complicated explanation."
      },
      {
        name: "Sushi",
        emoji: "🍣",
        description: "Neat, fresh, and colorful rolls for a lighter midday reset."
      },
      {
        name: "Hamburger",
        emoji: "🍔",
        description: "A satisfying stack of savory comfort, best enjoyed with both hands."
      },
      {
        name: "Hot Dog",
        emoji: "🌭",
        description: "A quick, cheerful favorite for the kind of lunch that keeps moving."
      },
      {
        name: "Spaghetti",
        emoji: "🍝",
        description: "Twirlable noodles with the cozy energy of a long Italian lunch."
      },
      {
        name: "Curry",
        emoji: "🍛",
        description: "A fragrant bowl of saucy comfort with rice ready to soak it all up."
      },
      {
        name: "Ramen",
        emoji: "🍜",
        description: "Steaming noodles for a warm bowl of savory, slurpy satisfaction."
      },
      {
        name: "Burrito",
        emoji: "🌯",
        description: "A portable, filling wrap that keeps every delicious layer together."
      },
      {
        name: "Falafel",
        emoji: "🧆",
        description: "Crisp, herby bites with a satisfying Middle Eastern twist."
      },
      {
        name: "Sandwich",
        emoji: "🥪",
        description: "The dependable lunch solution, layered exactly the way you like it."
      },
      {
        name: "Salad",
        emoji: "🥗",
        description: "A crisp, colorful bowl when lunch should feel fresh and energetic."
      },
      {
        name: "Pancakes",
        emoji: "🥞",
        description: "Fluffy stacks for a sweet lunch detour from the ordinary."
      },
      {
        name: "Waffles",
        emoji: "🧇",
        description: "Golden squares with plenty of cozy crunch in every bite."
      },
      {
        name: "Paella",
        emoji: "🥘",
        description: "A vibrant one-pan feast that brings a little sunshine to the table."
      },
      {
        name: "Pretzel",
        emoji: "🥨",
        description: "A warm, twisted bite with a satisfying chew and a salty finish."
      }
    ];

    const dishContent = document.getElementById("dishContent");
    const dishName = document.getElementById("dishName");
    const dishEmoji = document.getElementById("dishEmoji");
    const dishDescription = document.getElementById("dishDescription");
    const generateButton = document.getElementById("generateButton");

    let currentIndex = 0;

    function generateLunch() {
      let nextIndex = Math.floor(Math.random() * dishes.length);

      while (dishes.length > 1 && nextIndex === currentIndex) {
        nextIndex = Math.floor(Math.random() * dishes.length);
      }

      currentIndex = nextIndex;
      const dish = dishes[currentIndex];

      dishContent.classList.remove("animate");
      void dishContent.offsetWidth;
      dishContent.classList.add("animate");

      dishName.textContent = dish.name;
      dishEmoji.textContent = dish.emoji;
      dishEmoji.setAttribute("aria-label", dish.name);
      dishDescription.textContent = dish.description;
    }

    generateButton.addEventListener("click", generateLunch);
  </script>
</body>
</html>
